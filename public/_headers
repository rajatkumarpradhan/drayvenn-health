/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-src https://www.openstreetmap.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
/api/*
  Cache-Control: no-store
/
  Cache-Control: no-cache, must-revalidate
/admin
  Cache-Control: no-cache, must-revalidate
/*.html
  Cache-Control: no-cache, must-revalidate
/*.js
  Cache-Control: no-cache, must-revalidate
/*.css
  Cache-Control: no-cache, must-revalidate
/brand/*
  Cache-Control: no-cache, must-revalidate
/*.png
  Cache-Control: no-cache, must-revalidate
